---
import { Image } from 'astro:assets';
import myImage from '../assets/avatar.png';
import LogoLinkedin from '../logos/logo-linkedin.astro';
import LogoYoutube from '../logos/logo-youtube.astro';
---

<section
  class="max-w-120 mx-auto w-full flex flex-col gap-2.5 rounded-4xl p-8 border border-neutral-200/40 outline-dashed outline-offset-8 outline-neutral-200/20"
>
  <div class="flex items-center gap-2">
    <Image
      class="size-32 rounded-4xl"
      src={myImage}
      alt="Avatar image of Vasile Ropot"
    />
    <div class="flex flex-col gap-2">
      <h1 class="font-light text-2xl text-neutral-900">Vasile Ropot</h1>
      <p class="font-extralight text-sm italic text-neutral-700">
        Software Engineer
      </p>
      <div class="flex items-center gap-2">
        {
          [
            {
              logo: <LogoLinkedin class="size-5" />,
              label: 'LinkedIn',
              href: 'https://linkedin.com/in/ropotvs',
            },
            {
              logo: <LogoYoutube class="size-5" />,
              label: 'LinkedIn',
              href: 'https://youtube.com/ropotvs',
            },
          ].map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noreferrer noopener"
              title={social.label}
              class="size-12 shrink-0 rounded-xl border border-neutral-100 flex items-center justify-center"
            >
              {social.logo}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <hr class="border-neutral-100 max-w-20 w-full ml-6" />

  <div class="grid grid-cols-2 gap-2">
    <a
      class="bg-neutral-900 text-neutral-50 h-14 rounded-2xl flex items-center justify-center text-center text-sm font-light"
      href="https://wa.me/ropotvs"
      target="_blank"
      rel="noopener noreferrer"
    >
      Message on WhatsApp
    </a>
    <a
      class="text-neutral-900 h-14 rounded-2xl flex items-center justify-center text-center text-sm font-light border border-neutral-200"
      href="mailto:contact@ropotvs.com"
    >
      contact@ropotvs.com
    </a>
  </div>
</section>
